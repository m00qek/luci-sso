config oidc 'default'
	option enabled '0'
	option issuer_url 'https://accounts.google.com'
	# option internal_issuer_url ''
	option client_id 'REPLACE_ME'
	option client_secret 'REPLACE_ME'
	# Set this to https://<the name you open LuCI at>/cgi-bin/luci-sso/callback.
	# Left unset, the settings page suggests the browser's current host.
	# option redirect_uri ''
	option scope 'openid profile email'
	option clock_tolerance '60'

config role 'admin'
	list email 'admin@example.com'
	list read '*'
	list write '*'
