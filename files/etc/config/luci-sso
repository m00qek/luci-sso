config oidc 'default'
	option enabled '0'
	option issuer_url 'https://accounts.google.com'
	# option internal_issuer_url ''
	option client_id 'REPLACE_ME'
	option client_secret 'REPLACE_ME'
	# Set this to https://<the name you open LuCI at>/cgi-bin/luci-sso/callback.
	# Left unset, the settings page suggests the browser's current host.
	# option redirect_uri ''
	option scope 'openid profile email'
	option clock_tolerance '60'
	# A role matches by email only if the IdP marks the address as verified
	# (email_verified). Unset means on; '0' also matches unverified addresses.
	option require_email_verified '1'
	# Only behind a reverse proxy: its address. Requests from it skip the
	# per-client rate limits, so the proxy must limit clients itself.
	# list trusted_proxy '127.0.0.1'
	# The issuer the roles' sub rules were made for: they count only while
	# it is exactly issuer_url. The settings page sets it.
	# option sub_issuer ''

# A role's permissions are its rpcd login entry, luci_sso_<role> in
# /etc/config/rpcd, which the settings page edits. On install, this role gets
# read '*' and write '*' (full access, like root) if it still matches only
# admin@example.com; edited first, it gets an entry that grants nothing.
config role 'admin'
	list email 'admin@example.com'
