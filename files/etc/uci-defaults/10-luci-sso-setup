#!/bin/sh

# LuCI SSO - System Setup
# Create secure directory for OIDC discovery and JWKS caching.

CACHE_DIR="/var/run/luci-sso"

mkdir -p "$CACHE_DIR"
chown root:root "$CACHE_DIR"
chmod 0700 "$CACHE_DIR"

# Register the cleanup cron job: daily at 4:00, it removes expired token locks
# and handshakes. Added unless an active crontab line already runs the
# script; a comment that mentions it does not count.
[ -x /usr/sbin/luci-sso-cleanup ] && /usr/sbin/luci-sso-cleanup --install-cron

exit 0
