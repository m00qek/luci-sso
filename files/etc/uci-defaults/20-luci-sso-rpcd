#!/bin/sh

# LuCI SSO - role permissions in rpcd, and rpcd picking up the luci-sso object.
#
# 1. Upgrade, or reinstall after a removal put the lists back: each luci-sso
#    role still carrying read/write lists gets its rpcd login entry
#    (luci_sso_<role>) from them, and loses the lists. If the shipped `admin`
#    role, untouched, has no entry, it gets read '*' and write '*'. Any other
#    role without lists or entry gets an entry that grants nothing, and a
#    warning. luci_sso.rpcd_login.migrate() holds the rules; running it again
#    changes nothing. Changes go through a private UCI delta directory, so no one
#    else's staged change to rpcd or luci-sso is committed with them.
#
#    An upgrade from 0.10.0 finds every role without lists and with its entry,
#    so it changes nothing in either file. Only a global
#    luci-sso.default.sub_issuer, which no release ever wrote, is removed:
#    sub_issuer is an option of each role.
#
# 2. rpcd loads its plugins (/usr/share/rpcd/ucode/luci-sso.uc) only when it
#    starts or reloads, so after an install or upgrade the settings page could
#    not reach the new object until the next reboot. A reload (SIGHUP)
#    re-executes rpcd and keeps every session: each one's rights are rebuilt
#    from its login entry in /etc/config/rpcd, which step 1 has written.
#    /usr/libexec/luci-sso/rpcd-reload does it, never during a LuCI apply that
#    may still be rolled back.
#
# 3. The init script, which reloads rpcd when an apply changes a role's
#    entry, is enabled: a fresh install enables it on its own, but an upgrade
#    from 0.10.0, which had none, does not.
#
# Runs after an install or upgrade (the package's postinst runs uci-defaults)
# and at first boot, when rpcd is not running yet and the reload does nothing.

ucode -e '
import { cursor } from "uci";
import { mkdir } from "fs";
import { migrate } from "luci_sso.rpcd_login";

let delta = "/var/run/luci-sso/uci-defaults";
mkdir("/var/run/luci-sso", 0700);
mkdir(delta, 0700);
let uci = cursor("/etc/config", delta);
uci.revert("rpcd");
uci.revert("luci-sso");

let changed = migrate(uci, (msg) => print(msg, "\n"));
if (uci.get("luci-sso", "default", "sub_issuer") != null) {
	uci.delete("luci-sso", "default", "sub_issuer");
	changed.luci_sso = true;
}
if (changed.rpcd) uci.commit("rpcd");
if (changed.luci_sso) uci.commit("luci-sso");
' 2>&1 | while read -r line; do
	logger -t luci-sso -p user.warn "$line"
	echo "luci-sso: $line" >&2
done

if [ -x /usr/libexec/luci-sso/rpcd-reload ]; then
	/usr/libexec/luci-sso/rpcd-reload request
else
	[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd reload >/dev/null 2>&1
fi

[ -x /etc/init.d/luci-sso ] && /etc/init.d/luci-sso enable

exit 0
