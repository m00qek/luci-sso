#!/usr/bin/ucode
'use strict';

import * as fs from 'fs';
import * as uci from 'uci';
import * as ubus_mod from 'ubus';
import * as log from 'log';
import * as uloop from 'uloop';
import * as uclient from 'uclient';
import * as web_mod from 'luci_sso.web';
import * as config_loader from 'luci_sso.config';
import * as router from 'luci_sso.router';
import * as http_client from 'luci_sso.components.http_client';
import * as clock_mod from 'luci_sso.components.clock';
import * as Result from 'luci_sso.result';

log.openlog("luci-sso", log.LOG_PID, log.LOG_USER);

const syslog = function(level, msg) {
	let priority = (level == "error") ? log.LOG_ERR : (level == "warn") ? log.LOG_WARNING : (level == "debug") ? log.LOG_DEBUG : log.LOG_INFO;
	log.syslog(priority, msg);
};

let _ubus_conn = null;

const web_deps = {
	getenv: getenv,
	stdout: fs.stdout,
	log: syslog
};

const router_deps = {
	fs: {
		readfile:  (p)    => fs.readfile(p),
		writefile: (p, d) => fs.writefile(p, d),
		mkdir:     (p, m) => fs.mkdir(p, m),
		unlink:    (p)    => fs.unlink(p),
		rename:    (o, n) => fs.rename(o, n),
		stat:      (p)    => fs.stat(p),
		chmod:     (p, m) => fs.chmod(p, m),
		lsdir:     (p)    => fs.lsdir(p),
		error:     ()     => fs.error()
	},
	http: http_client.create(uclient, uloop, fs),
	ubus: {
		call: (obj, method, args) => {
			if (!_ubus_conn) {
				_ubus_conn = ubus_mod.connect();
				if (!_ubus_conn) return Result.err("UBUS_CONNECT_FAILED");
			}
			let res = _ubus_conn.call(obj, method, args);
			if (res === null) return Result.err("UBUS_ERROR");
			return Result.ok(res);
		}
	},
	uci: uci.cursor(),
	clock: clock_mod.create(uloop),
	log: syslog
};

try {
	const res_req = web_mod.request(web_deps);
	if (!res_req.ok) {
		let status = (type(res_req.details) == "object") ? res_req.details.http_status : 400;
		web_mod.render_error(web_deps, res_req.error, status);
		exit(0);
	}

	const req = res_req.data;

	// W2: Allow ?action=enabled even if config loading fails with SSO_DISABLED
	const res_c = config_loader.load({ uci: router_deps.uci, log: syslog });
	if (!res_c.ok) {
		if (res_c.error == "SSO_DISABLED" && req.path == "/" && req.query.action == "enabled") {
			const res_router = router.handle(router_deps, null, req);
			if (!res_router.ok) {
				let status = (type(res_router.details) == "object") ? res_router.details.http_status : 500;
				web_mod.render_error(web_deps, res_router.error, status);
			} else {
				web_mod.render(web_deps, res_router.data);
			}
			exit(0);
		}
		web_mod.render_error(web_deps, res_c.error, 500);
		exit(0);
	}

	const config = res_c.data;
	const res_router = router.handle(router_deps, config, req);
	if (!res_router.ok) {
		let status = (type(res_router.details) == "object") ? res_router.details.http_status : 500;
		web_mod.render_error(web_deps, res_router.error, status);
	} else {
		web_mod.render(web_deps, res_router.data);
	}
} catch (e) {
	web_mod.error(web_deps, e);
}
